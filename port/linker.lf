[mapping:rtthread]
archive: librtthread.a
entries:
    if IDF_RTOS_RTTHREAD = y:
        # Every IRAM ISR passes through these helpers while cache is off.
        irq (noflash)
        context_gcc (noflash)
        # Everything the trap path can reach, by whole object.
        #
        # Four separate rounds were lost to symbol lists that could not cover what
        # the compiler generates: rtatomic.h's inline helpers exist once per
        # translation unit under compiler-chosen names, and literal pools and jump
        # tables follow their functions. Each omission left part of the trap path
        # in flash, and the only symptom was a fault or a silent hang while the
        # flash cache is off during MSPI/PSRAM timing tuning.
        #
        # The archive as a whole is ~105 KB of text, more DRAM than this image can
        # spare, so the rule stops at the objects that matter:
        #
        #   irq, context_gcc, cpuport   - the trap entry/exit itself
        #   cpu_mp / cpu_up             - rt_cpus_lock and the atomics it uses
        #   scheduler_mp / scheduler_up - the critical-section helpers
        #   smp_prims / smp_stack       - ticket lock, cpu id, nest table
        #   thread                      - rt_thread_self, reached from xPortCanYield
        irq (noflash)
        context_gcc (noflash)
        cpuport (noflash)
        cpu_mp (noflash)
        cpu_up (noflash)
        scheduler_mp (noflash)
        scheduler_up (noflash)
        smp_prims (noflash)
        smp_stack (noflash)
        # atomic_riscv.c: reached from rt_interrupt_enter when RT_USING_HW_ATOMIC
        # is on. Without this the atomic lives in IROM and the trap path faults
        # there while the flash cache is off.
        atomic_riscv (noflash)
        thread:rt_thread_self (noflash)

        # ------------------------------------------------------------
        # The FreeRTOS shim's ISR path: a DIFFERENT way into the kernel
        # than the trap path above, and not covered by it.
        #
        # IDF's Wi-Fi driver registers its ISR with ESP_INTR_FLAG_IRAM
        # because real FreeRTOS keeps the corresponding queue code in
        # IRAM. This shim forwards to RT-Thread, so the same call arrives
        # at rt_sem_trytake / rt_sem_release / rt_schedule / object
        # helpers - none of which were in IRAM. Measured while re-joining
        # a network (NVS write, flash cache off):
        #
        #   MEPC = 0x4200d506  rt_sem_trytake  (flash)
        #   RA   = 0x40809762  ft_ipc_send_isr (IRAM)
        #
        # and after fixing that one, the same fault at
        # rt_object_get_type, which the RT_ASSERT inside _rt_sem_take
        # calls. Each round revealed one more object, so the whole of
        # `ipc` and `object` are taken rather than chasing symbols.
        #
        # NOTE: an external change has removed these lines more than
        # once. If a cache error appears at any rt_* symbol while an
        # interrupt is active, check here first.
        # ------------------------------------------------------------
        ipc (noflash)
        object (noflash)
        # The shim's own IPC layer, as a WHOLE OBJECT.
        #
        # `FT_IRAM` on the entry points is not enough and the reason is
        # structural: those functions call static helpers in the same file
        # (ft_ipc_push, ft_ipc_pop, ...) which carry no attribute and stayed
        # in flash. Adding the attribute per function is what kept failing:
        #
        #   MEPC = 0x4206f21e  ft_ipc_resolve   (flash)  <- fixed by FT_IRAM
        #   MEPC = 0x4206de8c  ft_ipc_push      (flash)  <- next one, same cause
        #   RA   = 0x40809720  ft_ipc_send_isr  (IRAM)
        #
        # Each round fixed the address that had crashed and exposed the next
        # one, which is why the symptom looked intermittent and the faulting
        # function changed every time. The whole file belongs to the
        # interrupt path, so the whole file goes to IRAM.
        ft_ipc (noflash)
        freertos_api (noflash)
        # kstring: rt_memcpy and friends, reached from ft_ipc_push.
        #
        # Fifth layer of the same problem. The chain is
        #
        #   Wi-Fi ISR -> xQueueGenericSendFromISR (IRAM)
        #     -> ft_ipc_send_isr -> ft_ipc_push (IRAM)
        #       -> rt_memcpy (flash)   <- measured MEPC 0x420011ae
        #
        # This is the point where the approach stops scaling: the shim
        # forwards to a kernel that is flash-resident by default, and IDF's
        # Wi-Fi ISR is registered with ESP_INTR_FLAG_IRAM because real
        # FreeRTOS keeps the equivalent queue code in IRAM. Pulling the
        # kernel in object by object will consume IRAM the kernel does not
        # fit in (~105 KB of text for ~80 KB of headroom).
        #
        # kstring is taken because it is small and on the path; if another
        # layer appears, the answer is the structural change (an ISR path
        # that does not call the kernel), not another line here.
        kstring (noflash)
        # scheduler_comm: seventh layer. rt_sem_release, called from the shim
        # ISR, dequeues a waiting thread and marks it ready:
        #
        #   RA   = 0x4081d1be  rt_susp_list_dequeue  (ipc.c:120, IRAM)
        #   MEPC = 0x4200cb0c  rt_sched_thread_ready (scheduler_comm.c:233, flash)
        #
        # The deferred-yield fix removed the rt_schedule() call from the ISR,
        # but release() reaches flash before it would ever get there. `ipc` is
        # already in IRAM; this is the file it calls next.
        #
        # STOPPING CONDITION: if an EIGHTH layer appears, the conclusion is
        # that the shim's ISR path cannot be made safe on this kernel by
        # relocation, and the limit gets documented instead.
        scheduler_comm (noflash)
        # ft_qset: sixth layer, reached from ft_ipc_send_isr (ft_qset.c:171).
        # Taken because it is small and already on the path; the note in
        # ft_ipc above still applies - if a SEVENTH layer appears, the answer
        # is the structural change, not another line here.
        ft_qset (noflash)
        ft_event (noflash)
        ft_notify (noflash)
        ft_task (noflash)
        thread:rt_thread_resume (noflash)
        thread:rt_thread_suspend (noflash)

        if IDF_TARGET_ESP32C3 = y:
            interrupt:rt_hw_interrupt_is_disabled (noflash)
        else:
            cpuport:rt_hw_interrupt_is_disabled (noflash)

        # Xtensa (ESP32-S3).
        #
        # The RISC-V trap path lives in libriscv.a, so names like cpu_mp, smp_prims
        # and atomic_riscv simply match nothing in this archive on Xtensa - which
        # is why the list above can stay shared instead of being split per target.
        #
        # What the Xtensa port adds is the equivalent of that trap path:
        # context_gcc.S (the five XT_RTOS_* callouts and the switch itself) and
        # interrupt.c (the trampoline every IDF-installed line runs through).
        # Both execute with PS.INTLEVEL at 1 and the flash cache potentially off -
        # the window IDF opens for SPI-flash writes and MSPI timing tuning - so
        # both must be in IRAM. `context_gcc (noflash)` above already covers the
        # assembly; this adds the C half, and cpuport (noflash) above already
        # covers rt_hw_interrupt_is_disabled and the ISR stack.
        if IDF_TARGET_ESP32S3 = y:
            interrupt (noflash)

[mapping:rtthread_cache_guard_abort]
archive: libesp_system.a
entries:
    if IDF_RTOS_RTTHREAD = y:
        # The cache-off guard must reach the panic trap even when the general
        # ESP_SYSTEM_IN_IRAM placement option is disabled.
        esp_system_chip:esp_system_abort (noflash)
        panic:panic_abort (noflash)
